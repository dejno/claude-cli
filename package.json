{
  "name": "claude-cli",
  "version": "1.0.0",
  "description": "Professional Claude API CLI Tool",
  "main": "dist/index.js",
  "bin": {
    "claude": "./dist/index.js"
  },
  "scripts": {
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
    "type-check": "tsc --noEmit",
    "type-check:watch": "tsc --noEmit --watch",
    "clean": "rimraf dist coverage .tsbuildinfo",
    "prebuild": "npm run clean",
    "prestart": "npm run build",
    "build": "rimraf dist && tsc",
    "build:watch": "tsc -w",
    "postbuild": "chmod +x dist/index.js",
    "poststart": "npm link"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.31.0",
    "axios": "^1.7.7",
    "chalk": "^4.1.2",
    "commander": "^11.1.0",
    "conf": "^10.2.0",
    "dotenv": "^16.3.1",
    "envalid": "^8.0.0",
    "inquirer": "^8.2.6",
    "nodemailer": "^6.9.16",
    "ora": "^5.4.1",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7",
    "uuid": "^11.0.2",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/inquirer": "^8.2.10",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.5",
    "@types/nodemailer": "^6.4.16",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
